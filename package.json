{
  "name": "webmcp-angular-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "ng build --configuration production && firebase deploy --only hosting",
    "deploy:only": "firebase deploy --only hosting",
    "experiment:build": "tsc -p tsconfig.external-agent.json && cp external-agent/package.json dist/external-agent/package.json",
    "experiment:start": "node dist/external-agent/scripts/experiment.js",
    "external-agent:build": "npm run experiment:build",
    "external-agent": "npm run external-agent:agent",
    "external-agent:agent": "npx adk run external-agent/agent.ts",
    "external-agent:web": "npx adk web external-agent"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@google/adk": "^0.1.3",
    "@mcp-b/webmcp-polyfill": "^2.3.2",
    "ollama": "^0.6.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@eslint/js": "^10.0.1",
    "@google/adk-devtools": "^0.1.3",
    "@types/node": "^25.9.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-check": "^4.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "puppeteer": "^25.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.0.8"
  }
}
