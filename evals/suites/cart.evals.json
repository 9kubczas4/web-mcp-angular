        "mockOutput": {
          "status": "success",
          "payload": {
            "items": [
              {
                "productId": "off-003",
                "name": "Mechanical Keyboard",
                "price": 129,
                "quantity": 1
              }
            ],
            "itemCount": 1,
            "total": 129
          }
        }
      }
    ]
  },
