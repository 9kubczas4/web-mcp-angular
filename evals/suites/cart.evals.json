[
  {
    "name": "Add two headphones",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Add two headphones to my cart. The headphones product id is aud-001."
      }
    ],
    "expectedCall": [
      {
        "functionName": "addToCart",
        "arguments": {
          "productId": "aud-001",
          "quantity": 2
        },
        "mockOutput": {
          "status": "success",
          "payload": {
            "items": [
              {
                "productId": "aud-001",
                "name": "Studio Over-Ear Headphones",
                "price": 199,
                "quantity": 2
              }
            ],
            "itemCount": 2,
            "total": 398
          }
        }
      }
    ]
  },
  {
    "name": "Add keyboard",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Add keyboard to my cart. The keyboard product id is off-003."
      }
    ],
    "expectedCall": [
      {
        "functionName": "addToCart",
        "arguments": {
          "productId": "off-003",
          "quantity": { "$gte": 1 }
