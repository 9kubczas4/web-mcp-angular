# Uses Gemini when GEMINI_API_KEY is set (default). For local Ollama instead:
# ADK_MODEL=llama3.1
GEMINI_API_KEY=your_gemini_api_key_here
# Default page when no url is passed to tools (optional; falls back to webmcp-angular-demo)
# WEBMCP_URL=https://example.com
# WEBMCP_MAX_INVOKES=3
# WEBMCP_MAX_LIST_TOOLS=1
# GEMINI_MODEL=gemini-3.5-flash
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
